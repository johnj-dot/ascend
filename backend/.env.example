# Ascend Backend Configuration
# Copy this file to .env and fill in your values

# ── Required: Gemini AI API Key ──────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: HAC Scraper URL ─────────────────────────────────────────────────
# Home Access Center login URL for your school district
HAC_URL=https://accesscenter.roundrockisd.org/HomeAccess/Account/LogOn?ReturnUrl=%2fhomeaccess%2f

# ── Optional: Server Port (defaults to 3001) ──────────────────────────────────
# PORT=3001
